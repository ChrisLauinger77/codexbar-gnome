#!/usr/bin/env bash
# codexbar-ssl-helper — Trust the local Antigravity server self-signed certificate.
# Zero Python/PyPI dependencies. Uses: ss, openssl, pkexec.
# Replaces the codexbar-ssl-helper PyPI package.
set -euo pipefail

VERSION="2.0.0"

# --- Discover local Antigravity / agy listening ports ---
discover_ports() {
  declare -a ports=()

  # Method A: ss -lntp
  if command -v ss &>/dev/null; then
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      # Skip header
      echo "$line" | grep -q '^State' && continue
      # Only local loopback addresses
      echo "$line" | grep -qE '127\.0\.0\.1|\[::1\]|0\.0\.0\.0|\[::\]' || continue
      # Process must match
      echo "$line" | grep -qiE 'agy|antigravity|language.server' || continue
      # Extract port
      local addr
      addr="$(echo "$line" | awk '{print $4}')"
      local port
      port="${addr##*:}"
      [[ "$port" =~ ^[0-9]+$ ]] || continue
      # Check it's not a duplicate
      local already=0
      for p in "${ports[@]}"; do [[ "$p" == "$port" ]] && already=1; done
      [[ $already -eq 0 ]] && ports+=("$port")
    done < <(ss -lnt -p 2>/dev/null) || true
  fi

  # Method B: Parse /proc/net/tcp
  if [[ ${#ports[@]} -eq 0 && -f /proc/net/tcp ]]; then
    while IFS= read -r line; do
      # Skip header
      echo "$line" | grep -q '^  sl' && continue
      local addr=""
      local state=""
      read -r -a parts <<< "$line"
      addr="${parts[1]}"
      state="${parts[3]}"
      [[ "$state" == "0A" ]] || continue  # LISTEN
      local host="${addr%:*}"
      local port_hex="${addr##*:}"
      [[ "$host" == "0100007F" || "$host" == "00000000" ]] || continue
      local port=$((16#$port_hex))
      local already=0
      for p in "${ports[@]}"; do [[ "$p" == "$port" ]] && already=1; done
      [[ $already -eq 0 ]] && ports+=("$port")
    done < /proc/net/tcp
  fi

  printf '%s\n' "${ports[@]:-}"
}

# --- Extract certificate from a port ---
extract_certificate() {
  local port="$1"
  if command -v timeout &>/dev/null; then
    timeout 5 bash -c 'echo | openssl s_client -connect 127.0.0.1:"$1" -servername localhost 2>/dev/null' _ "$port" \
      | openssl x509 2>/dev/null
  else
    echo | openssl s_client -connect "127.0.0.1:$port" -servername localhost 2>/dev/null \
      | openssl x509 2>/dev/null
  fi
}

main() {
  echo "CodexBar SSL Helper - Setting up Antigravity local SSL trust"
  echo "-------------------------------------------------------------"

  if ! command -v openssl &>/dev/null; then
    echo "[-] Error: 'openssl' is required but not found."
    exit 1
  fi

  readarray -t ports < <(discover_ports)

  if [[ ${#ports[@]} -eq 0 ]]; then
    echo "[-] Error: No active Antigravity / agy server processes found."
    echo "    Please make sure your local Antigravity server is running and listening."
    exit 1
  fi

  echo "[*] Discovered active local ports: ${ports[*]}"

  local cert=""
  local active_port=""
  for port in "${ports[@]}"; do
    echo "[*] Attempting to fetch certificate from port $port..."
    cert="$(extract_certificate "$port")"
    if echo "$cert" | grep -q -- "-----BEGIN CERTIFICATE-----"; then
      active_port="$port"
      echo "[+] Successfully extracted self-signed certificate from port $port!"
      break
    fi
  done

  if [[ -z "$cert" ]]; then
    echo "[-] Error: Could not extract self-signed certificate from any active port."
    echo "    Make sure the Antigravity server is running HTTPS with SSL enabled."
    exit 1
  fi

  # Detect CA trust directory and update command
  local dest_file=""
  local update_cmd=""
  if [[ -d "/etc/ca-certificates/trust-source/anchors" ]]; then
    # Arch Linux
    dest_file="/etc/ca-certificates/trust-source/anchors/antigravity.crt"
    update_cmd="update-ca-trust"
  elif [[ -d "/usr/local/share/ca-certificates" ]]; then
    # Debian / Ubuntu
    dest_file="/usr/local/share/ca-certificates/antigravity.crt"
    update_cmd="update-ca-certificates"
  elif [[ -d "/etc/pki/ca-trust/source/anchors" ]]; then
    # Fedora / RHEL
    dest_file="/etc/pki/ca-trust/source/anchors/antigravity.crt"
    update_cmd="update-ca-trust"
  else
    dest_file="/usr/local/share/ca-certificates/antigravity.crt"
    update_cmd="update-ca-certificates"
  fi

  echo "[*] Target location: $dest_file"
  echo "[*] Update command: $update_cmd"

  echo "[*] Installing certificate to system trust store (requires administrator privileges)..."

  local dest_dir
  dest_dir="$(dirname "$dest_file")"

  # Write the cert to a temp file to hand to pkexec (avoid shell injection / quoting issues)
  local tmp_cert
  tmp_cert="$(mktemp /tmp/antigravity-cert-XXXXXX.crt)"
  printf '%s\n' "$cert" > "$tmp_cert"

  if command -v pkexec &>/dev/null; then
    pkexec sh -c "mkdir -p \"$dest_dir\" && cp \"$tmp_cert\" \"$dest_file\" && chmod 644 \"$dest_file\" && $update_cmd" \
      && { echo "[+] Success! Antigravity certificate has been successfully installed and trusted."; rm -f "$tmp_cert"; exit 0; } \
      || { echo "[-] Error: Failed to install certificate."; rm -f "$tmp_cert"; exit 1; }
  else
    echo "[-] Error: 'pkexec' (polkit) is required to elevate privileges but was not found."
    rm -f "$tmp_cert"
    exit 1
  fi
}

main "$@"
